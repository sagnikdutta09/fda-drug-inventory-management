<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OtherManufacturerValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Manufacturer__c , &quot;Other&quot;), ISBLANK( Other_Manufacturer__c))</errorConditionFormula>
    <errorMessage>Please fill in Other Manufacturer when Manufacturer is set to Other.</errorMessage>
</ValidationRule>
