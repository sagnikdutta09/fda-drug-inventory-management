<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PhoneNumberValidation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(
    REGEX(
        Patient_Phone__c,
        &quot;^\\+?[1-9][0-9]{7,14}$&quot;
    )
)</errorConditionFormula>
    <errorDisplayField>Patient_Phone__c</errorDisplayField>
    <errorMessage>Enter a valid 10-digit Indian mobile number.</errorMessage>
</ValidationRule>
